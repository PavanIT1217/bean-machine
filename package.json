{
  "name": "bean-machine",
  "version": "1.0.0",
  "description": "Galton \u2014 an interactive Galton board (bean machine) with hand-written 2D physics, Pascal's triangle and a live bell curve. Web, PWA, iOS and Android.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/generate-icons.mjs && npx @capacitor/assets generate --iconBackgroundColor '#fbf8f1' --iconBackgroundColorDark '#14120e' --splashBackgroundColor '#fbf8f1' --splashBackgroundColorDark '#14120e'",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "playwright-core": "1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "homepage": "https://pavanit1217.github.io/bean-machine/",
  "repository": {
    "type": "git",
    "url": "https://github.com/PavanIT1217/bean-machine.git"
  },
  "engines": {
    "node": ">=22"
  }
}
